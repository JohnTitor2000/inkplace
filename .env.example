# Required in production. Local development falls back to a built-in secret
# so email register/login works with no env file.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:43127

# Google OAuth. Both values are required or the button stays disabled.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth. Both values are required or the button stays disabled.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe one-time donations (test keys are fine locally).
# Without these, the donation form is visible and explains that keys are
# required. No payment is marked successful.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Required only for POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# The database is SQLite at prisma/dev.db. No DATABASE_URL is required.
