# Required in production. Local development falls back to a built-in secret
# so email register/login works with no env file.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:43127

# Google OAuth. Both values are required or the button stays disabled.
# Callback: /api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign in with Apple. Both values are required or the button stays disabled.
# AUTH_APPLE_SECRET is the JWT client secret Apple expects, not a plain string.
# Apple only accepts an HTTPS callback, so http://127.0.0.1 cannot finish this login.
# Callback: /api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Microsoft Entra ID. The id and secret are required. The issuer is optional
# and defaults to https://login.microsoftonline.com/common/v2.0 (personal,
# work, and school accounts). Set a tenant issuer to limit sign-in to one directory.
# Callback: /api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# GitHub OAuth. Both values are required or the button stays disabled.
# Callback: /api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe one-time donations (test keys are fine locally).
# Without these, the donation form is visible and explains that keys are
# required. No payment is marked successful.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Required only for POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# The database is SQLite at prisma/dev.db. No DATABASE_URL is required.
